<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>Nova.AiLab.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <DefineConstants>$(DefineConstants);NOVA_FIXED_POINT</DefineConstants>
  </PropertyGroup>

  <!-- Same checkout the lab itself measures — see Nova.AiLab.csproj for why
       this is a property and not a fixed path. -->
  <PropertyGroup>
    <NovaRepo Condition="'$(NovaRepo)' == ''">$(MSBuildThisFileDirectory)..\..\Project_Nova</NovaRepo>
    <NovaScripts>$(NovaRepo)\Assets\_Project\Scripts</NovaScripts>
  </PropertyGroup>

  <Target Name="NovaRepoExists" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(NovaScripts)')"
           Text="NovaRepo does not point at a Project Nova checkout: '$(NovaRepo)' has no Assets/_Project/Scripts." />
  </Target>

  <ItemGroup>
    <Compile Include="$(NovaScripts)\Core\**\*.cs" Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="$(NovaScripts)\Simulation\**\*.cs" Link="Simulation\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="$(NovaScripts)\AI\**\*.cs" Link="AI\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="$(NovaScripts)\AI.Data\**\*.cs" Link="AI.Data\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- The lab under test, folder by folder (Match/, Metrics/, View/, Sweep/,
         Duel/, Movement/, Compare/, Cli/). Two exclusions, both load-bearing:
         Program.cs is the entry point and would collide with the test host,
         and obj/ holds generated AssemblyInfo.cs — pulling it in fails the
         build with duplicate assembly attributes (CS0579).

         Cli/ USED TO BE EXCLUDED as "argument plumbing around that same entry
         point". Only Program.cs is that; Options.cs is the rule about which
         flag a mode may carry and what values it accepts, which is ordinary
         logic and was the one part of the lab with no test at all. It is
         internal, and compiling it into this assembly is what makes it
         reachable from a test without opening it up to the world. -->
    <Compile Include="..\Nova.AiLab\**\*.cs"
             Exclude="..\Nova.AiLab\bin\**\*.cs;..\Nova.AiLab\obj\**\*.cs;..\Nova.AiLab\Program.cs"
             Link="AiLab\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- THE SAME EMBEDDED PAGES THE LAB CARRIES, AND NOT OPTIONAL.
       This project compiles the lab's SOURCES rather than referencing its
       assembly, so `typeof(HtmlPlayer).Assembly` resolves to THIS assembly
       when a test runs. Without these two items the resource lookup finds
       nothing and every test that writes a run's artifacts fails at run time
       — the LogicalName has to match Nova.AiLab.csproj exactly. -->
  <ItemGroup>
    <EmbeddedResource Include="..\Nova.AiLab\View\Player.template.html"
                      LogicalName="Nova.AiLab.View.Player.template.html" />
    <EmbeddedResource Include="..\Nova.AiLab\Compare\Report.head.html"
                      LogicalName="Nova.AiLab.Compare.Report.head.html" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="4.2.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

</Project>
